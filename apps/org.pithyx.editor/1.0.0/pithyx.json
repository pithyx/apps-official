{
  "$schema": "./node_modules/@pithyx/sdk/schema/manifest.v1.schema.json",
  "manifestVersion": 1,
  "id": "org.pithyx.editor",
  "version": "1.0.0",
  "name": { "en": "Editor", "de": "Editor" },
  "description": {
    "en": "Edit text, configuration and code files with syntax highlighting, write Markdown with a live preview, and change binary files byte by byte in the hex editor. Several files open as tabs, and every window is on its own.",
    "de": "Bearbeite Text-, Konfigurations- und Codedateien mit Syntaxhervorhebung, schreibe Markdown mit Live-Vorschau und ändere Binärdateien Byte für Byte im Hex-Editor. Mehrere Dateien öffnen sich als Tabs, und jedes Fenster ist für sich."
  },
  "author": { "name": "The Pithyx project", "url": "https://pithyx.org" },
  "license": "MIT",
  "homepage": "https://github.com/pithyx/apps-official/tree/master/apps/org.pithyx.editor",
  "entry": "frontend/index.html",
  "sdk": "^1.0.0",
  "pithyx": ">=1.0.0",
  "permissions": ["files.read", "files.write"],
  "window": {
    "instances": "multi",
    "defaultSize": { "width": 1000, "height": 700 },
    "minSize": { "width": 360, "height": 300 },
    "loading": { "untilReady": true }
  },
  "fileHandlers": [
    {
      "extensions": ["md", "markdown", "mdown", "mkd", "txt", "text"],
      "isDefault": true
    },
    {
      "extensions": [
        "yaml",
        "yml",
        "toml",
        "json",
        "jsonc",
        "json5",
        "ini",
        "conf",
        "cfg",
        "cnf",
        "properties",
        "env",
        "service",
        "timer",
        "socket",
        "mount",
        "network",
        "netdev",
        "rules",
        "editorconfig",
        "gitignore",
        "dockerignore",
        "dockerfile",
        "containerfile",
        "nginx",
        "caddyfile",
        "htaccess",
        "tf",
        "hcl",
        "nix"
      ],
      "isDefault": true
    },
    {
      "extensions": [
        "sh",
        "bash",
        "zsh",
        "fish",
        "ps1",
        "bat",
        "cmd",
        "py",
        "js",
        "mjs",
        "cjs",
        "jsx",
        "ts",
        "mts",
        "cts",
        "tsx",
        "css",
        "scss",
        "less",
        "sql",
        "lua",
        "go",
        "rs",
        "c",
        "h",
        "cpp",
        "hpp",
        "cc",
        "java",
        "kt",
        "cs",
        "php"
      ],
      "isDefault": true
    },
    {
      "extensions": [
        "rb",
        "pl",
        "r",
        "swift",
        "diff",
        "patch",
        "tex",
        "rst",
        "adoc",
        "srt",
        "vtt",
        "makefile",
        "mk",
        "cmake",
        "gradle",
        "vue",
        "svelte"
      ],
      "isDefault": true
    },
    {
      "extensions": ["log", "csv", "tsv", "xml", "svg", "html", "htm", "xhtml", "plist", "xsd", "xsl"]
    },
    {
      "extensions": ["bin", "dat", "rom", "hex", "dump"]
    }
  ]
}
